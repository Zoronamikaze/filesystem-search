#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 10

// Structure to represent a file or directory node
typedef struct {
    char name[30];
    int isDirectory; // 1 if directory, 0 if file
} Node;

Node nodes[MAX];
int adj[MAX][MAX];
int n = 0; // Number of nodes

// Function to add a node to the graph
void addNode(const char* name, int isDir) {
    if (n >= MAX) return;
    strcpy(nodes[n].name, name);
    nodes[n].isDirectory = isDir;
    n++;
}

// Function to add an edge between nodes
void addEdge(int u, int v) {
    adj[u][v] = 1;
    adj[v][u] = 1; // Assuming undirected graph representation of file paths
}

// Breadth-First Search (BFS) to find a file
void bfsSearch(int start, const char* target) {
    int visited[MAX] = {0};
    int queue[MAX], front = 0, rear = 0;

    visited[start] = 1;
    queue[rear++] = start;

    printf("\n--- BFS Traversal Order ---\n");
    while (front < rear) {
        int current = queue[front++];
        printf("%s ", nodes[current].name);

        // Check if target found
        if (strcmp(nodes[current].name, target) == 0) {
            printf("\n[SUCCESS] File '%s' found using BFS!\n", target);
            return;
        }

        // Explore neighbors
        for (int i = 0; i < n; i++) {
            if (adj[current][i] == 1 && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }
    printf("\n[FAILED] File '%s' not found using BFS.\n", target);
}

// Helper function for DFS recursion
int dfsUtil(int current, const char* target, int visited[]) {
    visited[current] = 1;
    printf("%s ", nodes[current].name);

    if (strcmp(nodes[current].name, target) == 0) {
        return 1; // Found
    }

    for (int i = 0; i < n; i++) {
        if (adj[current][i] == 1 && !visited[i]) {
            if (dfsUtil(i, target, visited)) {
                return 1;
            }
        }
    }
    return 0;
}

// Depth-First Search (DFS) to find a file
void dfsSearch(int start, const char* target) {
    int visited[MAX] = {0};
    printf("\n--- DFS Traversal Order ---\n");
    int found = dfsUtil(start, target, visited);
    if (found) {
        printf("\n[SUCCESS] File '%s' found using DFS!\n", target);
    } else {
        printf("\n[FAILED] File '%s' not found using DFS.\n", target);
    }
}

int main() {
    // Initialize adjacency matrix
    for (int i = 0; i < MAX; i++)
        for (int j = 0; j < MAX; j++)
            adj[i][j] = 0;

    // Step 1: Create a mock file system hierarchy
    // Nodes: 0:root, 1:Documents, 2:Downloads, 3:resume.pdf, 4:notes.txt, 5:installer.exe
    addNode("root", 1);          // 0
    addNode("Documents", 1);     // 1
    addNode("Downloads", 1);     // 2
    addNode("resume.pdf", 0);    // 3
    addNode("notes.txt", 0);     // 4
    addNode("installer.exe", 0); // 5

    // Connect directories and files (Edges)
    addEdge(0, 1); // root -> Documents
    addEdge(0, 2); // root -> Downloads
    addEdge(1, 3); // Documents -> resume.pdf
    addEdge(1, 4); // Documents -> notes.txt
    addEdge(2, 5); // Downloads -> installer.exe

    // Display Adjacency Matrix
    printf("File System Adjacency Matrix:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("%d ", adj[i][j]);
        }
        printf("\n");
    }

    // Step 2 & 3: Search for a target file using BFS and DFS
    char targetFile[] = "notes.txt";
    printf("\nSearching for target file: '%s' starting from 'root' (Node 0)\n", targetFile);

    bfsSearch(0, targetFile);
    dfsSearch(0, targetFile);

    return 0;
}
